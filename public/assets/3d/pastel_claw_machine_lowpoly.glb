<body class="l4u-body bg-lfu-surface text-lfu-ink font-body" data-page="not-found">
  <div class="l4u-background" aria-hidden="true">
    <span class="l4u-blob l4u-blob-a"></span>
    <span class="l4u-blob l4u-blob-b"></span>
    <span class="l4u-blob l4u-blob-c"></span>
  </div>

  <div data-l4u-nav></div>

  <main class="relative z-10 mx-auto flex min-h-[85vh] w-full max-w-4xl items-center px-4 py-16 md:px-8">
    <section class="l4u-surface-glass w-full rounded-[2rem] p-6 text-center shadow-haze md:p-10" aria-labelledby="notFoundTitle">
      <p class="l4u-kicker">Page unavailable</p>
      <div class="mx-auto mt-5 flex h-16 w-16 items-center justify-center rounded-full bg-lfu-primary/10 text-lfu-primary">
        <span class="material-symbols-outlined text-4xl" aria-hidden="true">drafts</span>
      </div>
      <h1 id="notFoundTitle" class="mt-6 font-headline text-4xl font-extrabold tracking-tight text-lfu-primary md:text-6xl">
        This letter is not here anymore.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-lfu-outline md:text-base">
        The share link may be mistyped, deleted, expired, private, or not published yet. You can still create a new Letter4U page or go back home.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="l4u-gradient-button rounded-full px-6 py-3 text-xs font-bold uppercase tracking-[0.1em]">
          Go Home
        </a>
        <a href="/pages/create" class="rounded-full border border-lfu-primary/20 bg-white/85 px-6 py-3 text-xs font-bold uppercase tracking-[0.1em] text-lfu-primary">
          Create a Letter
        </a>
      </div>
    </section>
  </main>

  <script defer src="/scripts/site.js?v=20260808-locket-drafts-v1"></script>
